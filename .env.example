# Copy to `.env` and fill in real values. `.env` is gitignored — never commit real
# credentials.
#
# This is the ONE shared, repo-root config that names the project a template is
# pushed to — the example templates under examples/* are deliberately
# project-INDEPENDENT and carry no project config of their own. `pnpm validate`
# and `pnpm push` (run from inside an example) load this file: validate runs the
# integration layer's schema validation (POST /api/<project>/extensions/validate),
# push builds + validates and then uploads the bundle (PUT /api/<project>/extensions).
#
# To push a template to a DIFFERENT project, point this file at that project (or
# override CTP_PROJECT_KEY + its creds in the environment). NOTE: the object store
# holds one bundle per project, so pushing a second template to the same project
# replaces the first.

# Base URL of the integration layer. Defaults to the deployed instance; for local
# development against a locally running integration layer, set http://localhost:8080.
INTEGRATION_LAYER_URL=https://integration-layer.stage.europe-west1.gcp.commercetools.com

# The commercetools project to push the bundle for (must be a project the integration
# layer is configured to serve). Not a secret — it's the project key in URLs.
CTP_PROJECT_KEY=your-project-key

# commercetools auth host for your project's region — used to mint the push token.
# Defaults to Europe (GCP, Belgium). Use the host for the region your project is in:
#   https://auth.europe-west1.gcp.commercetools.com        Europe        (GCP, Belgium)
#   https://auth.eu-central-1.aws.commercetools.com        Europe        (AWS, Frankfurt)
#   https://auth.us-central1.gcp.commercetools.com         North America (GCP, Iowa)
#   https://auth.us-east-2.aws.commercetools.com           North America (AWS, Ohio)
#   https://auth.australia-southeast1.gcp.commercetools.com Australia     (GCP, Sydney)
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com

# A commercetools API client for the project above WITH the `manage_project` scope —
# the integration layer's PUT /api/<project>/extensions route requires it. Only
# CTP_CLIENT_SECRET is a secret.
CTP_CLIENT_ID=your-ct-client-id
CTP_CLIENT_SECRET=your-ct-client-secret
